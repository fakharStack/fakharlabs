# =============================================================
#  Fakhar Labs — environment variables
#  Copy to `.env` for local dev; add the same keys in Vercel.
# =============================================================

# ---------- CLIENT (safe to expose in the browser) ----------
# Clerk publishable key — Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Your Supabase project — Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------- SERVER ONLY (NEVER expose to the browser) ----------
# Never prefix these with VITE_ — that would ship them to the client.

# Clerk secret key — Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Same publishable key as above, server-side (Clerk needs it to verify sessions)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Same Supabase project, server-side credentials
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin allowlist — who may use /admin (comma separated).
# Set at least one of these, otherwise the admin API denies everyone.
ADMIN_EMAILS=you@youragency.com
# ADMIN_CLERK_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxx
